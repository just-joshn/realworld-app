{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    // "node" is node10, which oxlint's TypeScript 7 checker rejects. bundler matches Vite.
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "types": ["node"],
    "paths": {
      "msw/node": ["./node_modules/msw/lib/node/index.d.ts"],
      "msw/graphql": ["./node_modules/msw/lib/graphql/index.d.ts"],
      "msw/browser": ["./node_modules/msw/lib/browser/index.d.ts"],
      "vitest/browser": ["./node_modules/vitest/browser/context.d.ts"]
    }
  },
  "include": ["src", "backend", "scripts", "test", "playwright", "playwright.config.ts"]
}
