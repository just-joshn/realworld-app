  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently bun:start:react bun:start:api:watch",
    "dev:auth0": "cross-env VITE_AUTH0=true NODE_ENV=development concurrently bun:start:react bun:start:api:watch",
    "dev:okta": "cross-env VITE_OKTA=true NODE_ENV=development concurrently bun:start:react bun:start:api:watch",
    "dev:cognito": "cross-env VITE_AWS_COGNITO=true NODE_ENV=development concurrently bun:start:react bun:start:api:watch",
    "dev:google": "cross-env VITE_GOOGLE=true NODE_ENV=development concurrently bun:start:react bun:start:api:watch",
    "predev:cognito": "bun run build:aws-exports-es5",
    "predev:cognito:ci": "bun run copy:mock:awsexports && bun run copy:mock:awsexportses5",
    "copy:mock:awsexports": "ncp scripts/mock-aws-exports.js src/aws-exports.js",
    "copy:mock:awsexportses5": "ncp scripts/mock-aws-exports-es5.js aws-exports-es5.js",
    "build:aws-exports-es5": "cross-env tsc --skipLibCheck --allowJs --lib 'es5' --module 'commonjs' --target 'es5' --moduleResolution 'node' --outDir . src/aws-exports.js; mv aws-exports.js aws-exports-es5.js",
    "start": "cross-env NODE_ENV=development concurrently bun:start:react bun:start:api",
    "start:ci": "cross-env NODE_ENV=test concurrently bun:start:react:proxy-server bun:start:api",
    "prestart:ci": "bun run predev:cognito:ci",
    "start:react": "vite",
    "start:empty": "cross-env NODE_ENV=development EMPTY_SEED=true concurrently bun:start:react bun:start:api:watch",
    "lint": "oxlint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "list:dev:users": "cat data/database.json | json -a users | json -a id username",
    "types": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "start:api": "bun run tsnode --files backend/app.ts",
    "start:api:watch": "nodemon --exec bun run tsnode --watch 'backend' backend/app.ts",
    "start:react:proxy-server": "bun run tsnode scripts/testServer.ts",
    "tsnode": "ts-node -P tsconfig.tsnode.json",
    "db:seed": "bun run tsnode scripts/generateSeedData",
    "predb:seed:dev": "bun run predev:cognito:ci",
    "db:seed:dev": "ncp ./data/database-seed.json ./data/database.json",
    "db:seed:empty": "ncp ./data/empty-seed.json ./data/database.json",
    "postdb:seed": "bun run db:seed:dev",
    "prestart": "bun run db:seed:dev",
    "predev": "bun run db:seed:dev",
    "prestart:empty": "bun run db:seed:empty",
    "prebuild": "bun run types",
    "prebuild:ci": "bun run predev:cognito:ci",
    "build:ci": "vite build",
    "build": "vite build",
    "codesandbox:start:api": "bun run tsnode --files backend/app.ts",
    "codesandbox:start": "NODE_ENV=development TSC_COMPILE_ON_ERROR=true concurrently \"vite\" bun:codesandbox:start:api",
    "prepare": "husky",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "coverage": "vitest run --coverage --project unit --project \"browser (chromium)\"",
    "test:browser": "vitest run --project browser",
    "test:integration": "vitest run --project integration",
    "test:playwright": "playwright test",
    "test:e2e": "playwright test --project=e2e --project=e2e-mobile",
    "test:api": "playwright test --project=api",
    "coverage:integration": "vitest run --project integration --coverage.enabled --coverage.include=src/components --coverage.include=src/containers --coverage.include=src/machines --coverage.include=src/utils --coverage.exclude='src/containers/App{Auth0,Cognito,Google,Okta}.tsx' --coverage.reportsDirectory=coverage/integration"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
